# StockFlow Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Usage:
#   cp .env.example .env
#   Then edit .env with your production values.

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here-change-this
DJANGO_DEBUG=False

# ---------------------------------------------------------------------------
# Database (PostgreSQL for production)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/stockflow_db

# ---------------------------------------------------------------------------
# Email (SMTP for production)
# Switch EMAIL_BACKEND to smtp to send real emails.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=StockFlow System <noreply@yourdomain.com>

# Password reset link validity in seconds (default: 259200 = 3 days)
PASSWORD_RESET_TIMEOUT=259200

# ---------------------------------------------------------------------------
# Development overrides (use console email backend locally)
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
